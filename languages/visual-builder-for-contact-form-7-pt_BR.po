#. Name of the plugin
msgid "Visual Builder for Contact Form 7"
msgstr "Visual Builder for Contact Form 7"

#. URI of the plugin
msgid "https://etruel.com/downloads/visual-builder-contact-form-7/"
msgstr ""

#. Description of the plugin
msgid "Build Contact Form 7 forms visually: drag & drop fields, live preview, one-click field editing and a code editor, side by side. Requires Contact Form 7."
msgstr "Crie formulários do Contact Form 7 visualmente: arraste e solte campos, pré-visualização ao vivo, edição de campos com um clique e um editor de código, lado a lado. Requer o Contact Form 7."

#. Author of the plugin
msgid "Etruel Developments LLC"
msgstr "Etruel Developments LLC"

#. Author URI of the plugin
msgid "https://etruel.com"
msgstr ""

#. translators: 1: required Contact Form 7 version, 2: installed version
#: cf7-visual-builder.php:82
#, php-format
msgid "Visual Builder for Contact Form 7 needs Contact Form 7 %1$s or newer (installed: %2$s). Please update Contact Form 7 to use the Visual Builder."
msgstr "O Visual Builder for Contact Form 7 precisa do Contact Form 7 %1$s ou mais recente (instalado: %2$s). Atualize o Contact Form 7 para usar o Visual Builder."

#: class.wpcf7vb-extension-activation.php:50
msgid "This plugin"
msgstr "Este plugin"

#: class.wpcf7vb-extension-activation.php:87
msgid "activate it"
msgstr "ativá-lo"

#: class.wpcf7vb-extension-activation.php:90
msgid "install it"
msgstr "instalá-lo"

#: class.wpcf7vb-extension-activation.php:97
#, php-format
msgid " requires Contact Form 7! Please %s first and then activate this."
msgstr " requer o Contact Form 7! Você precisa %s primeiro e depois ativar este plugin."

