msgstr "Monter"

#: includes/class-wpecf7vb-admin.php:205
msgid "Move down"
msgstr "Descendre"

#: includes/class-wpecf7vb-admin.php:206
msgid "Drag to reorder"
msgstr "Glisser pour réorganiser"

#: includes/class-wpecf7vb-admin.php:207
msgid "Edit"
msgstr "Modifier"

#: includes/class-wpecf7vb-admin.php:208
msgid "Duplicate"
