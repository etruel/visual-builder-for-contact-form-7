msgstr "Bloc supprimé."

#. translators: %d: new position of the block
#: includes/class-wpecf7vb-admin.php:213
#, php-format
msgid "Block moved to position %d."
msgstr "Bloc déplacé en position %d."

#: includes/class-wpecf7vb-admin.php:214
msgid "Block duplicated."
msgstr "Bloc dupliqué."

#: includes/class-wpecf7vb-admin.php:215
msgid "Form-tag inserted."
msgstr "Balise de formulaire insérée."

#: includes/class-wpecf7vb-admin.php:216
msgid "New fields go at the code cursor"
msgstr "Les nouveaux champs sont insérés à l’emplacement du curseur dans le code"

#. translators: %d: block number
#: includes/class-wpecf7vb-admin.php:218
#, php-format
msgid "New fields go after block %d · Click to use the code cursor"
msgstr "Les nouveaux champs sont insérés après le bloc %d · Cliquez pour utiliser le curseur du code"

#: includes/class-wpecf7vb-admin.php:219
msgid "Block updated."
msgstr "Bloc mis à jour."

#: includes/class-wpecf7vb-admin.php:220
msgid "Updating preview…"
msgstr "Mise à jour de l’aperçu…"

#: includes/class-wpecf7vb-admin.php:221
msgid "The preview could not be updated. Your form is not affected."
msgstr "L’aperçu n’a pas pu être mis à jour. Votre formulaire n’est pas affecté."

#: includes/class-wpecf7vb-admin.php:222
msgid "Retry"
msgstr "Réessayer"

#: includes/class-wpecf7vb-admin.php:223
msgid "1 block"
msgstr "1 bloc"

#. translators: %d: number of blocks in the form, always more than one
#: includes/class-wpecf7vb-admin.php:225
#, php-format
msgid "%d blocks"
msgstr "%d blocs"

#: includes/class-wpecf7vb-admin.php:226
msgid "This block has no visible output."
msgstr "Ce bloc n’a aucun rendu visible."

#: includes/class-wpecf7vb-admin.php:227
msgid "Styles for the form. They are applied on your site, not in this preview."
msgstr "Styles du formulaire. Ils sont appliqués sur votre site, pas dans cet aperçu."

#: includes/class-wpecf7vb-admin.php:228
msgid "Script for the form. It runs on your site, not in this preview."
msgstr "Script du formulaire. Il s’exécute sur votre site, pas dans cet aperçu."

#: includes/class-wpecf7vb-admin.php:229
msgid "Edit block"
msgstr "Modifier le bloc"

#: includes/class-wpecf7vb-admin.php:230
msgid "Form-tag"
msgstr "Balise de formulaire"

#: includes/class-wpecf7vb-admin.php:231
msgid "Label"
msgstr "Libellé"

#: includes/class-wpecf7vb-admin.php:232
msgid "Text shown with the field. Leave it empty for no label."
msgstr "Texte affiché avec le champ. Laissez vide pour ne pas afficher de libellé."

#: includes/class-wpecf7vb-admin.php:233
msgid "Title of the group of choices, shown as a fieldset legend. Leave it empty for none."
msgstr "Titre du groupe de choix, affiché comme légende du fieldset. Laissez vide pour ne pas en afficher."

#: includes/class-wpecf7vb-admin.php:234
msgid "Name"
msgstr "Nom"

#: includes/class-wpecf7vb-admin.php:235
msgid "Options"
msgstr "Options"

#: includes/class-wpecf7vb-admin.php:236
msgid "Space separated, e.g. id:my-id class:my-class placeholder autocomplete:email"
msgstr "Séparées par des espaces, par ex. id:mon-id class:ma-classe placeholder autocomplete:email"

#: includes/class-wpecf7vb-admin.php:237
msgid "Values"
msgstr "Valeurs"

#: includes/class-wpecf7vb-admin.php:238
msgid "One per line. For drop-down menus, checkboxes and radio buttons each line is a choice."
msgstr "Une par ligne. Pour les menus déroulants, les cases à cocher et les boutons radio, chaque ligne est un choix."

#: includes/class-wpecf7vb-admin.php:239
msgid "Content"
msgstr "Contenu"

#: includes/class-wpecf7vb-admin.php:240
msgid "Block source"
msgstr "Source du bloc"

#: includes/class-wpecf7vb-admin.php:241
msgid "Everything this block contains: labels, HTML and form-tags."
msgstr "Tout ce que contient ce bloc : libellés, HTML et balises de formulaire."

#: includes/class-wpecf7vb-admin.php:242
msgid "Preview"
msgstr "Aperçu"

#: includes/class-wpecf7vb-admin.php:243
msgid "Apply changes"
msgstr "Appliquer les modifications"

#: includes/class-wpecf7vb-admin.php:244
msgid "Cancel"
msgstr "Annuler"

#: includes/class-wpecf7vb-admin.php:245
msgid "Close"
msgstr "Fermer"

#: includes/class-wpecf7vb-admin.php:246
msgid "This form-tag uses a syntax the field editor cannot read. Edit it in the block source below."
msgstr "Cette balise de formulaire utilise une syntaxe que l’éditeur de champ ne peut pas lire. Modifiez-la dans la source du bloc ci-dessous."

#: includes/class-wpecf7vb-admin.php:247
msgid "Names may use letters, numbers, hyphens, underscores, colons and periods, and must start with a letter."
msgstr "Les noms peuvent contenir des lettres, des chiffres, des traits d’union, des tirets bas, des deux-points et des points, et doivent commencer par une lettre."

#: includes/class-wpecf7vb-admin.php:248
msgid "This block has no form-tags. Edit its HTML in the block source."
msgstr "Ce bloc ne contient aucune balise de formulaire. Modifiez son HTML dans la source du bloc."

#: includes/class-wpecf7vb-admin.php:262
msgid "Split"
msgstr "Scindé"

#: includes/class-wpecf7vb-admin.php:263
#: includes/class-wpecf7vb-admin.php:303
msgid "Code"
msgstr "Code"

#: includes/class-wpecf7vb-admin.php:264
#: includes/class-wpecf7vb-admin.php:321
msgid "Visual"
msgstr "Visuel"

#. translators: %s: URL to the Contact Form 7 docs about the form template
#: includes/class-wpecf7vb-admin.php:276
#, php-format
msgid "Drag blocks to reorder them, click one to find it in the code, or use the buttons below to add fields. <a href=\"%s\" target=\"_blank\" rel=\"noopener\">Editing form template</a>."
msgstr "Faites glisser les blocs pour les réorganiser, cliquez sur l’un d’eux pour le trouver dans le code ou utilisez les boutons ci-dessous pour ajouter des champs. <a href=\"%s\" target=\"_blank\" rel=\"noopener\">Modification du modèle de formulaire</a>."

#: includes/class-wpecf7vb-admin.php:285
msgid "Editor layout"
msgstr "Mise en page de l’éditeur"

#: includes/class-wpecf7vb-admin.php:301
msgid "Form template code"
msgstr "Code du modèle de formulaire"

#: includes/class-wpecf7vb-admin.php:306
msgid "Code color scheme"
msgstr "Jeu de couleurs du code"

#: includes/class-wpecf7vb-admin.php:319
msgid "Visual form"
msgstr "Formulaire visuel"

#: includes/class-wpecf7vb-admin.php:327
msgid "Your form is empty."
msgstr "Votre formulaire est vide."

#: includes/class-wpecf7vb-admin.php:328
msgid "Add fields with the buttons above or write the template in the code editor."
msgstr "Ajoutez des champs avec les boutons ci-dessus ou écrivez le modèle dans l’éditeur de code."

#: includes/class-wpecf7vb-admin.php:345
msgid "You are not allowed to edit this contact form."
msgstr "Vous n’avez pas les droits nécessaires pour modifier ce formulaire de contact."

#: includes/class-wpecf7vb-admin.php:352
msgid "Invalid request."
msgstr "Requête invalide."
