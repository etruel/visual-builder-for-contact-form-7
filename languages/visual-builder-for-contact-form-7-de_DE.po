#. Name of the plugin
msgid "Visual Builder for Contact Form 7"
msgstr "Visual Builder for Contact Form 7"

#. URI of the plugin
msgid "https://etruel.com/downloads/visual-builder-contact-form-7/"
msgstr ""

#. Description of the plugin
msgid "Build Contact Form 7 forms visually: drag & drop fields, live preview, one-click field editing and a code editor, side by side. Requires Contact Form 7."
msgstr "Erstelle Contact-Form-7-Formulare visuell: Felder per Drag-and-drop, Live-Vorschau, Feldbearbeitung mit einem Klick und ein Code-Editor, Seite an Seite. Erfordert Contact Form 7."

#. Author of the plugin
msgid "Etruel Developments LLC"
msgstr "Etruel Developments LLC"

#. Author URI of the plugin
msgid "https://etruel.com"
msgstr ""

#. translators: 1: required Contact Form 7 version, 2: installed version
#: cf7-visual-builder.php:82
#, php-format
msgid "Visual Builder for Contact Form 7 needs Contact Form 7 %1$s or newer (installed: %2$s). Please update Contact Form 7 to use the Visual Builder."
msgstr "Visual Builder for Contact Form 7 benötigt Contact Form 7 %1$s oder neuer (installiert: %2$s). Bitte aktualisiere Contact Form 7, um den Visual Builder zu verwenden."

#: class.wpcf7vb-extension-activation.php:50
msgid "This plugin"
msgstr "Dieses Plugin"

#: class.wpcf7vb-extension-activation.php:87
msgid "activate it"
msgstr "aktiviere es"

#: class.wpcf7vb-extension-activation.php:90
msgid "install it"
msgstr "installiere es"

#: class.wpcf7vb-extension-activation.php:97
#, php-format
msgid " requires Contact Form 7! Please %s first and then activate this."
msgstr " erfordert Contact Form 7! Bitte %s zuerst und aktiviere dann dieses Plugin."

#: includes/class-wpecf7vb-admin.php:44
msgid "Default"
msgstr "Standard"

#: includes/class-wpecf7vb-admin.php:116
msgid "Visual Form"
msgstr "Visuelles Formular"

#: includes/class-wpecf7vb-admin.php:200
msgid "Block"
msgstr "Block"

#: includes/class-wpecf7vb-admin.php:201
msgid "HTML"
msgstr "HTML"

#: includes/class-wpecf7vb-admin.php:202
msgid "Text"
msgstr "Text"

#: includes/class-wpecf7vb-admin.php:203
msgid "Required"
msgstr "Erforderlich"

#: includes/class-wpecf7vb-admin.php:204
msgid "Move up"
msgstr "Nach oben verschieben"

#: includes/class-wpecf7vb-admin.php:205
msgid "Move down"
msgstr "Nach unten verschieben"

#: includes/class-wpecf7vb-admin.php:206
msgid "Drag to reorder"
msgstr "Zum Sortieren ziehen"

#: includes/class-wpecf7vb-admin.php:207
msgid "Edit"
msgstr "Bearbeiten"

#: includes/class-wpecf7vb-admin.php:208
msgid "Duplicate"
msgstr "Duplizieren"

#: includes/class-wpecf7vb-admin.php:209
msgid "Delete"
msgstr "Löschen"

#: includes/class-wpecf7vb-admin.php:210
msgid "Undo"
msgstr "Rückgängig"

#: includes/class-wpecf7vb-admin.php:211
msgid "Block deleted."
msgstr "Block gelöscht."

#. translators: %d: new position of the block
#: includes/class-wpecf7vb-admin.php:213
#, php-format
msgid "Block moved to position %d."
msgstr "Block an Position %d verschoben."

#: includes/class-wpecf7vb-admin.php:214
msgid "Block duplicated."
msgstr "Block dupliziert."

#: includes/class-wpecf7vb-admin.php:215
msgid "Form-tag inserted."
msgstr "Formular-Tag eingefügt."

#: includes/class-wpecf7vb-admin.php:216
msgid "New fields go at the code cursor"
msgstr "Neue Felder werden an der Cursorposition im Code eingefügt"

#. translators: %d: block number
#: includes/class-wpecf7vb-admin.php:218
#, php-format
msgid "New fields go after block %d · Click to use the code cursor"
msgstr "Neue Felder werden nach Block %d eingefügt · Klicken, um die Cursorposition im Code zu verwenden"

#: includes/class-wpecf7vb-admin.php:219
msgid "Block updated."
msgstr "Block aktualisiert."

#: includes/class-wpecf7vb-admin.php:220
msgid "Updating preview…"
msgstr "Vorschau wird aktualisiert …"

#: includes/class-wpecf7vb-admin.php:221
msgid "The preview could not be updated. Your form is not affected."
msgstr "Die Vorschau konnte nicht aktualisiert werden. Dein Formular ist davon nicht betroffen."

#: includes/class-wpecf7vb-admin.php:222
msgid "Retry"
msgstr "Erneut versuchen"

#: includes/class-wpecf7vb-admin.php:223
msgid "1 block"
msgstr "1 Block"

#. translators: %d: number of blocks in the form, always more than one
#: includes/class-wpecf7vb-admin.php:225
#, php-format
msgid "%d blocks"
msgstr "%d Blöcke"

#: includes/class-wpecf7vb-admin.php:226
msgid "This block has no visible output."
msgstr "Dieser Block hat keine sichtbare Ausgabe."

#: includes/class-wpecf7vb-admin.php:227
msgid "Styles for the form. They are applied on your site, not in this preview."
msgstr "Stile für das Formular. Sie werden auf deiner Website angewendet, nicht in dieser Vorschau."

#: includes/class-wpecf7vb-admin.php:228
msgid "Script for the form. It runs on your site, not in this preview."
msgstr "Skript für das Formular. Es wird auf deiner Website ausgeführt, nicht in dieser Vorschau."

#: includes/class-wpecf7vb-admin.php:229
msgid "Edit block"
msgstr "Block bearbeiten"

#: includes/class-wpecf7vb-admin.php:230
msgid "Form-tag"
msgstr "Formular-Tag"

#: includes/class-wpecf7vb-admin.php:231
msgid "Label"
msgstr "Beschriftung"

#: includes/class-wpecf7vb-admin.php:232
msgid "Text shown with the field. Leave it empty for no label."
msgstr "Text, der mit dem Feld angezeigt wird. Leer lassen für keine Beschriftung."

#: includes/class-wpecf7vb-admin.php:233
msgid "Title of the group of choices, shown as a fieldset legend. Leave it empty for none."
msgstr "Titel der Auswahlgruppe, angezeigt als Fieldset-Legende. Leer lassen, wenn keiner gewünscht ist."

#: includes/class-wpecf7vb-admin.php:234
msgid "Name"
msgstr "Name"

#: includes/class-wpecf7vb-admin.php:235
msgid "Options"
msgstr "Optionen"

#: includes/class-wpecf7vb-admin.php:236
msgid "Space separated, e.g. id:my-id class:my-class placeholder autocomplete:email"
msgstr "Durch Leerzeichen getrennt, z. B. id:meine-id class:meine-klasse placeholder autocomplete:email"

#: includes/class-wpecf7vb-admin.php:237
msgid "Values"
msgstr "Werte"

#: includes/class-wpecf7vb-admin.php:238
msgid "One per line. For drop-down menus, checkboxes and radio buttons each line is a choice."
msgstr "Einer pro Zeile. Bei Drop-down-Menüs, Kontrollkästchen und Radio-Buttons ist jede Zeile eine Auswahlmöglichkeit."

#: includes/class-wpecf7vb-admin.php:239
msgid "Content"
msgstr "Inhalt"

#: includes/class-wpecf7vb-admin.php:240
msgid "Block source"
msgstr "Block-Quelltext"

#: includes/class-wpecf7vb-admin.php:241
msgid "Everything this block contains: labels, HTML and form-tags."
msgstr "Alles, was dieser Block enthält: Beschriftungen, HTML und Formular-Tags."

#: includes/class-wpecf7vb-admin.php:242
msgid "Preview"
msgstr "Vorschau"

#: includes/class-wpecf7vb-admin.php:243
msgid "Apply changes"
msgstr "Änderungen anwenden"

#: includes/class-wpecf7vb-admin.php:244
msgid "Cancel"
msgstr "Abbrechen"

#: includes/class-wpecf7vb-admin.php:245
msgid "Close"
msgstr "Schließen"

#: includes/class-wpecf7vb-admin.php:246
msgid "This form-tag uses a syntax the field editor cannot read. Edit it in the block source below."
msgstr "Dieser Formular-Tag verwendet eine Syntax, die der Feld-Editor nicht lesen kann. Bearbeite ihn unten im Block-Quelltext."

#: includes/class-wpecf7vb-admin.php:247
msgid "Names may use letters, numbers, hyphens, underscores, colons and periods, and must start with a letter."
msgstr "Namen dürfen Buchstaben, Zahlen, Bindestriche, Unterstriche, Doppelpunkte und Punkte enthalten und müssen mit einem Buchstaben beginnen."

#: includes/class-wpecf7vb-admin.php:248
msgid "This block has no form-tags. Edit its HTML in the block source."
msgstr "Dieser Block enthält keine Formular-Tags. Bearbeite sein HTML im Block-Quelltext."

#: includes/class-wpecf7vb-admin.php:262
msgid "Split"
msgstr "Geteilt"

#: includes/class-wpecf7vb-admin.php:263
#: includes/class-wpecf7vb-admin.php:303
msgid "Code"
msgstr "Code"

#: includes/class-wpecf7vb-admin.php:264
#: includes/class-wpecf7vb-admin.php:321
msgid "Visual"
msgstr "Visuell"

#. translators: %s: URL to the Contact Form 7 docs about the form template
#: includes/class-wpecf7vb-admin.php:276
#, php-format
msgid "Drag blocks to reorder them, click one to find it in the code, or use the buttons below to add fields. <a href=\"%s\" target=\"_blank\" rel=\"noopener\">Editing form template</a>."
msgstr "Ziehe Blöcke, um sie neu anzuordnen, klicke auf einen, um ihn im Code zu finden, oder verwende die Buttons unten, um Felder hinzuzufügen. <a href=\"%s\" target=\"_blank\" rel=\"noopener\">Formular-Template bearbeiten</a>."

#: includes/class-wpecf7vb-admin.php:285
msgid "Editor layout"
msgstr "Editor-Layout"

#: includes/class-wpecf7vb-admin.php:301
msgid "Form template code"
msgstr "Code des Formular-Templates"

#: includes/class-wpecf7vb-admin.php:306
msgid "Code color scheme"
msgstr "Farbschema des Codes"

#: includes/class-wpecf7vb-admin.php:319
msgid "Visual form"
msgstr "Visuelles Formular"

#: includes/class-wpecf7vb-admin.php:327
msgid "Your form is empty."
msgstr "Dein Formular ist leer."

#: includes/class-wpecf7vb-admin.php:328
msgid "Add fields with the buttons above or write the template in the code editor."
msgstr "Füge Felder mit den Buttons oben hinzu oder schreibe das Template im Code-Editor."

#: includes/class-wpecf7vb-admin.php:345
msgid "You are not allowed to edit this contact form."
msgstr "Du bist nicht berechtigt, dieses Kontaktformular zu bearbeiten."

#: includes/class-wpecf7vb-admin.php:352
msgid "Invalid request."
msgstr "Ungültige Anfrage."
